# ==============================================================================
# DHAAL (ढाल) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# Do NOT commit .env.local or sensitive credentials to version control.
# ==============================================================================

# --- Frontend (Vite) Configuration ---
# Local development: defaults to http://localhost:8001 if unset
# Production (Vercel): leave empty or unset to use same-origin (/api) relative routing
VITE_API_BASE_URL=http://localhost:8001

# --- Backend (FastAPI / Uvicorn) Configuration ---
# Server listening port for local development and standalone container hosts
PORT=8001

# --- Vercel Serverless Python Environment Configuration ---
# File linking mode for Python packages in Vercel build containers (copy | clone)
UV_LINK_MODE=copy
