# DHAAL (ढाल) - Environment Variables Configuration

# Frontend (Vite) API Base URL
# Local development default: http://localhost:8001
# Production (Vercel Serverless): Leave empty or unset for same-origin (/api) relative routing
VITE_API_BASE_URL=http://localhost:8001

# Backend (FastAPI / Uvicorn) Server Port
# Default: 8001
PORT=8001

# Vercel Serverless Python Environment Configuration
# Options: copy | clone | hardlink (default on Vercel build containers is copy)
UV_LINK_MODE=copy
